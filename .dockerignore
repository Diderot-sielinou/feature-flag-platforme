# ================================
# .dockerignore
# ================================

# Git
.git
.gitignore
.gitattributes

# CI/CD
.github
.gitlab-ci.yml

# Documentation
*.md
README.md
docs/

# IDE
.vscode
.idea
*.swp
*.swo
*~

# Tests
**/*.test.ts
**/*.spec.ts
**/test/
coverage/
.nyc_output/

# Build artifacts (on les rebuild dans Docker)
**/dist/
**/.turbo/
.next/

# Environment files (gérés séparément)
.env.local
.env.*.local
.env.development
.env.test

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# Docker
docker-compose.yml
docker/
Dockerfile*

# Autres
.husky/
.turbo/
.cache/
tmp/
temp/

# Dépendances
node_modules


# Scripts
scripts
*.sh
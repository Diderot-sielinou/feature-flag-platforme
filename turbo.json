{
  "$schema": "https://turbo.build/schema.json",

  "globalDependencies": [
    "**/.env.*local",
    "package.json",
    "turbo.json",
    "eslintrc.js",
    "packages/eslint-config/**"
  ],

  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "REDIS_HOST",
    "REDIS_PORT",
    "MESSAGING_PROVIDER",
    "EMAIL_PROVIDER",
    "CLERK_SECRET_KEY",
    "CLERK_ISSUER_URL",
    "PORT",
    "DB_HOST",
    "DB_USERNAME",
    "DB_PASSWORD",
    "DB_PORT",
    "DB_NAME"
  ],

  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "build/**", ".turbo/**", ".tsbuildinfo"],
      "env": ["NODE_ENV"],
      "cache": true
    },

    "dev": {
      "cache": false,
      "persistent": true
    },

    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "env": ["NODE_ENV"]
    },

    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },

    "type-check": {
      "dependsOn": ["^build"],
      "outputs": []
    },

    "deploy": {
      "dependsOn": ["build", "test"],
      "outputs": [],
      "env": ["AWS_REGION", "AWS_ACCOUNT_ID", "CI", "GIT_COMMIT_SHA"]
    },

    "infra:*": {
      "cache": false,
      "dependsOn": [],
      "env": ["CDK_DEFAULT_ACCOUNT", "CDK_DEFAULT_REGION", "AWS_PROFILE"]
    },

    "db:generate": {
      "cache": false,
      "outputs": ["node_modules/.prisma/**", "prisma/client/**"]
    },

    "db:migrate:dev": {
      "cache": false
    }
  }
}

# ================================
# .dockerignore
# ================================

# Git
.git
.gitignore
.gitattributes

# CI/CD
.github
.gitlab-ci.yml

# Documentation
*.md
docs/

# IDE
.vscode
.idea
*.swp
*.swo
*~

# Tests
**/*.test.ts
**/*.spec.ts
**/test/
**/tests/
coverage/
.nyc_output/

# Build artifacts (rebuilt inside Docker)
**/dist/
**/.turbo/
**/.next/

# Environment files (injected at runtime)
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# Docker (avoid recursion)
docker-compose*.yml
Dockerfile*
.docker

# Hooks & caches
.husky/
.turbo/
.cache/
tmp/
temp/

# Dependencies (rebuilt in Docker)
node_modules
**/node_modules
.pnpm-store

# Infrastructure (not needed in app images)
infrastructure/

# Keep migrate.sh (needed for DB migrations in container)
!packages/database/migrate.sh
